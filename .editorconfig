root = true

[*]
# Keep in sync with .oxfmtrc.json — oxfmt is the source of truth for JS
indent_style = space
indent_size = 2
max_line_length = 120

end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,cjs,ts,cts}]
quote_type = single

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown uses trailing whitespace for hard line breaks
[*.md]
trim_trailing_whitespace = false
max_line_length = off
