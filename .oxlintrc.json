{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "node": true,
    "mocha": true,
    "es2023": true
  },
  "rules": {
    "new-cap": [
      "warn",
      {
        "capIsNewExceptions": [
          "ARRAY",
          "BigInt",
          "BIGINT",
          "BLOB",
          "BOOLEAN",
          "CHAR",
          "DATE",
          "DATEONLY",
          "DECIMAL",
          "DOUBLE",
          "ENUM",
          "FLOAT",
          "GEOGRAPHY",
          "GEOMETRY",
          "HSTORE",
          "INTEGER",
          "MEDIUMINT",
          "NOW",
          "NUMERIC",
          "RANGE",
          "REAL",
          "SET_DEFERRED",
          "SMALLINT",
          "STRING",
          "TEXT",
          "TINYINT",
          "UUID",
          "UUIDV1",
          "UUIDV4"
        ]
      }
    ],
    "no-extra-boolean-cast": "warn",
    "no-var": "error",
    "prefer-const": "error",
    "prefer-arrow-callback": "error",
    "no-cond-assign": ["error", "except-parens"],
    "curly": "error",
    "eqeqeq": "error",
    "no-extend-native": "error",
    "no-caller": "error",
    "no-undef": "error",
    "no-unused-vars": "error",
    "no-irregular-whitespace": "error",
    "max-depth": ["error", 8],
    "no-loop-func": "warn",
    "object-shorthand": "error",
    "no-shadow": "warn",
    "prefer-object-has-own": "error",
    "no-prototype-builtins": "error"
  },
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "no-unused-expressions": "off",
        "prefer-arrow-callback": "off"
      }
    }
  ]
}
