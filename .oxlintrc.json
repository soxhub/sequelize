{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "oxc", "promise", "node", "import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "node": true,
    "es2023": true
  },
  "rules": {
    "new-cap": [
      "warn",
      {
        "properties": false,
        "capIsNewExceptions": [
          "ARRAY",
          "BigInt",
          "BIGINT",
          "BLOB",
          "BOOLEAN",
          "CHAR",
          "DATE",
          "DATEONLY",
          "DECIMAL",
          "DOUBLE",
          "ENUM",
          "FLOAT",
          "GEOGRAPHY",
          "GEOMETRY",
          "HSTORE",
          "INTEGER",
          "MEDIUMINT",
          "NOW",
          "NUMERIC",
          "RANGE",
          "REAL",
          "SET_DEFERRED",
          "SMALLINT",
          "STRING",
          "TEXT",
          "TINYINT",
          "UUID",
          "UUIDV1",
          "UUIDV4"
        ]
      }
    ],
    "no-extra-boolean-cast": "warn",
    "no-var": "error",
    "prefer-const": "error",
    "prefer-arrow-callback": "error",
    "no-cond-assign": ["error", "except-parens"],
    "curly": "error",
    "eqeqeq": "error",
    "no-extend-native": "error",
    "no-caller": "error",
    "no-undef": "error",
    "no-unused-vars": "error",
    "no-irregular-whitespace": "error",
    "max-depth": ["error", 8],
    "no-loop-func": "warn",
    "object-shorthand": "error",
    "no-shadow": "warn",
    "prefer-object-has-own": "error",
    "no-prototype-builtins": "error",
    "import/namespace": ["error", { "allowComputed": true }],
    "no-promise-executor-return": "error",
    "prefer-promise-reject-errors": "error",
    "preserve-caught-error": "error",
    "no-fallthrough": "error",
    "no-eq-null": "error",
    "no-case-declarations": "error",
    "no-new-func": "error",
    "no-useless-call": "error",
    "no-object-constructor": "error",
    "guard-for-in": "error",
    "require-await": "error",
    "radix": "error",
    "unicorn/no-array-method-this-argument": "error",
    "unicorn/no-useless-promise-resolve-reject": "error",
    "unicorn/error-message": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "vitest/no-focused-tests": "error",
    // Every suite here is gated on `current.dialect.supports.*`, so a conditional around a test is
    // the norm rather than a smell.
    "vitest/no-conditional-tests": "off",
    // The rule only looks at the test body, so it cannot see an assertion that lives in a helper.
    // `assertFunctionNames` covers the helpers this suite asserts through, which takes 280 hits down
    // to 94, and inlining hook assertions plus giving the enum tests real round-trips took it to 77.
    // Those 77 still assert nothing — they only check that a call does not throw — so this stays off
    // until they are given real assertions.
    "vitest/expect-expect": [
      "off",
      {
        "assertFunctionNames": ["expect", "assert", "expect*", "testSuccess", "testFailure", "checkTimezoneParsing"]
      }
    ],
    // Assertions use the chai chain that vitest's `expect` exposes, which this rule reads as an
    // unknown modifier — `expect(x).to.equal(y)` is 5153 hits on its own.
    "vitest/valid-expect": "off",
    // Several suites assert inside `beforeEach` rather than in the test body.
    "vitest/no-standalone-expect": "off",
    // Same reason as `no-conditional-tests`: assertions sit inside `dialect.supports.*` and server
    // version gates, which the rule reads as conditional.
    "vitest/no-conditional-expect": "off",
    // Titles are built by `Support.getTestDialectTeaser()`, not string literals.
    "vitest/valid-title": "off",
    // A bare `rejects.toThrow()` is the faithful reading of chai-as-promised's `.to.be.rejected`:
    // the assertion is that it rejects at all. Requiring a message would invent one.
    "vitest/require-to-throw-message": "off",
    // 11 real duplicate titles predate the vitest migration; turn this on once they are renamed.
    "vitest/no-identical-title": "off"
  },
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "no-unused-expressions": "off"
      }
    }
  ]
}
