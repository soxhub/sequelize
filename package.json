{
  "name": "sequelize",
  "version": "400.52.6",
  "description": "PostgreSQL ORM for Node.JS",
  "keywords": [
    "nodejs",
    "object relational mapper",
    "orm",
    "postgres",
    "postgresql"
  ],
  "license": "MIT",
  "author": "Sascha Depold <sascha@depold.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/soxhub/sequelize.git"
  },
  "files": [
    "lib",
    "index.js",
    "index.cjs",
    "index.d.ts",
    "index.d.cts"
  ],
  "type": "module",
  "main": "./index.cjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      },
      "default": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint --report-unused-disable-directives-severity=error lib test",
    "test:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/types/tsconfig.json",
    "fmt": "oxfmt --write lib test",
    "fmt:check": "oxfmt --check lib test",
    "test": "pnpm run teaser && pnpm run test-unit && pnpm run test-integration",
    "test-docker": "pnpm run test-docker-unit && pnpm run test-docker-integration",
    "test-docker-unit": "pnpm run test-unit",
    "test-docker-integration": "env-cmd -f ./test/config/.docker.env pnpm run test-integration",
    "teaser": "node -e \"console.log('#'.repeat(process.env.DIALECT.length + 22) + '\\n# Running tests for ' + process.env.DIALECT + ' #\\n' + '#'.repeat(process.env.DIALECT.length + 22))\"",
    "test-integration": "vitest run --config vitest.integration.config.js",
    "test-integration-watch": "vitest --config vitest.integration.config.js",
    "test-unit": "vitest run",
    "test-unit-watch": "vitest",
    "test-integration-postgres": "cross-env DIALECT=postgres pnpm run test-integration",
    "test-integration-postgres-native": "cross-env DIALECT=postgres-native pnpm run test-integration",
    "test-postgres": "cross-env DIALECT=postgres pnpm test",
    "test-postgres-docker": "DIALECT=postgres SEQ_PORT=8996 SEQ_USER=sequelize_test SEQ_PW=sequelize_test SEQ_DB=sequelize_test pnpm test",
    "test-integration-postgres-docker": "DIALECT=postgres SEQ_PORT=8996 SEQ_USER=sequelize_test SEQ_PW=sequelize_test SEQ_DB=sequelize_test pnpm run test-integration",
    "test-postgres-native": "cross-env DIALECT=postgres-native pnpm test",
    "test-postgresn": "pnpm run test-postgres-native",
    "test-all": "pnpm run test-postgres && pnpm run test-postgres-native",
    "sscce": "env-cmd -f $npm_package_options_env_cmd node sscce.js",
    "sscce-postgres": "cross-env DIALECT=postgres pnpm run sscce"
  },
  "dependencies": {
    "@terraformer/wkt": "^2.2.2",
    "debug": "^4.4.3",
    "generic-pool": "3.9.0",
    "inflection": "^3.0.2",
    "lodash": "^4.18.1",
    "retry-as-promised": "^7.1.0",
    "semver": "^7.5.2",
    "uuid": "^14.0.2",
    "validator": "^13.15.26",
    "wkx": "^0.5.0"
  },
  "devDependencies": {
    "@types/cls-hooked": "4.3.9",
    "@types/lodash": "4.17.25",
    "@types/node": "20.19.43",
    "@types/validator": "13.15.10",
    "big-integer": "1.6.52",
    "cls-hooked": "4.2.2",
    "cross-env": "10.1.0",
    "env-cmd": "11.0.0",
    "moment": "2.30.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "pg": "8.23.0",
    "pg-hstore": "2.3.4",
    "pg-native": "3.9.0",
    "pg-types": "2.2.0",
    "sinon": "22.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "pg": "^8.19.0"
  },
  "engines": {
    "node": ">=20.20.0"
  },
  "volta": {
    "node": "24.18.1",
    "pnpm": "10.34.5"
  },
  "packageManager": "pnpm@10.34.5",
  "options": {
    "env_cmd": "./test/config/.docker.env"
  }
}
